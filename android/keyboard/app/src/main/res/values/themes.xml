<resources>
    <!--
        DayNight parent keeps the system-following contract. Keyboard views resolve
        their own palette in Kotlin (dark by default, light only for UI_MODE_NIGHT_NO),
        so the new kb_* colors here are the shared tokens for chrome and dialogs.
    -->
    <style name="Theme.NewPgpKeyboard" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/kb_accent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/kb_background</item>
    </style>
</resources>
