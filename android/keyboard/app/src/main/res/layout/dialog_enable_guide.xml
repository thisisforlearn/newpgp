<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/keyboard_background"
    android:fillViewport="true"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/guide_title"
            android:textColor="@color/key_text"
            android:textSize="@dimen/guide_title_text_size"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/guide_intro"
            android:textColor="@color/key_function_text"
            android:textSize="@dimen/guide_text_size" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="top">

            <TextView
                android:id="@+id/guideBadge1"
                android:layout_width="@dimen/guide_badge_size"
                android:layout_height="@dimen/guide_badge_size"
                android:background="@drawable/guide_step_badge"
                android:gravity="center"
                android:textColor="@color/status_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/guide_step_1"
                android:textColor="@color/key_text"
                android:textSize="@dimen/guide_text_size" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="top">

            <TextView
                android:id="@+id/guideBadge2"
                android:layout_width="@dimen/guide_badge_size"
                android:layout_height="@dimen/guide_badge_size"
                android:background="@drawable/guide_step_badge"
                android:gravity="center"
                android:textColor="@color/status_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/guide_step_2"
                android:textColor="@color/key_text"
                android:textSize="@dimen/guide_text_size" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="top">

            <TextView
                android:id="@+id/guideBadge3"
                android:layout_width="@dimen/guide_badge_size"
                android:layout_height="@dimen/guide_badge_size"
                android:background="@drawable/guide_step_badge"
                android:gravity="center"
                android:textColor="@color/status_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/guide_step_3"
                android:textColor="@color/key_text"
                android:textSize="@dimen/guide_text_size" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="top">

            <TextView
                android:id="@+id/guideBadge4"
                android:layout_width="@dimen/guide_badge_size"
                android:layout_height="@dimen/guide_badge_size"
                android:background="@drawable/guide_step_badge"
                android:gravity="center"
                android:textColor="@color/status_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/guide_step_4"
                android:textColor="@color/key_text"
                android:textSize="@dimen/guide_text_size" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/status_background"
            android:padding="12dp"
            android:text="@string/guide_engine_note"
            android:textColor="@color/status_text"
            android:textSize="@dimen/guide_text_size" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@color/status_background"
            android:padding="12dp"
            android:text="@string/guide_privacy_note"
            android:textColor="@color/status_text"
            android:textSize="@dimen/guide_text_size" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/guideCloseButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/guide_button_height"
            android:layout_marginTop="20dp"
            android:text="@string/guide_close"
            android:textAllCaps="false"
            android:textColor="@color/status_text"
            android:textSize="@dimen/guide_text_size"
            app:backgroundTint="@color/status_background"
            app:cornerRadius="12dp"
            app:strokeColor="@color/suggestion_highlight"
            app:strokeWidth="2dp" />

    </LinearLayout>

</ScrollView>
