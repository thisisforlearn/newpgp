<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/keyboard_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="@color/key_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_intro"
            android:textColor="@color/key_function_text"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/guide_card_background"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_guide_heading"
                android:textColor="@color/key_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/settings_guide_subtitle"
                android:textColor="@color/key_function_text"
                android:textSize="@dimen/guide_text_size" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/guideButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/guide_button_height"
                android:layout_marginTop="12dp"
                android:text="@string/settings_guide_button"
                android:textAllCaps="false"
                android:textColor="@color/status_text"
                android:textSize="@dimen/guide_text_size"
                app:backgroundTint="@color/status_background"
                app:cornerRadius="12dp"
                app:strokeColor="@color/suggestion_highlight"
                app:strokeWidth="2dp" />

        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/autocorrectSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/settings_autocorrect"
            android:textColor="@color/key_text"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/settings_autocorrect_summary"
            android:textColor="@color/key_function_text"
            android:textSize="13sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/autoAppendSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/settings_auto_append"
            android:textColor="@color/key_text"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/settings_auto_append_summary"
            android:textColor="@color/key_function_text"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@color/status_background"
            android:padding="12dp"
            android:text="@string/settings_warning_body"
            android:textColor="@color/status_text"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/settings_privacy_note"
            android:textColor="@color/key_function_text"
            android:textSize="13sp" />

    </LinearLayout>

</ScrollView>
