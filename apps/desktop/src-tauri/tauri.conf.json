{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NewPGP",
  "version": "0.1.3",
  "identifier": "app.newpgp.desktop",
  "build": {
    "beforeDevCommand": "",
    "devUrl": null,
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "NewPGP — private made simple",
        "width": 1120,
        "height": 780,
        "minWidth": 820,
        "minHeight": 620,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "category": "Productivity",
    "shortDescription": "Friendly OpenPGP email and file encryption",
    "longDescription": "NewPGP makes OpenPGP usable without technical setup: automatic key discovery, a built-in mail workflow, encrypted drafts, local search and file encryption."
  }
}
