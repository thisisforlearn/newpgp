{
  "manifest_version": 3,
  "name": "NewPGP for Webmail",
  "version": "0.1.0",
  "description": "Add OpenPGP to Gmail and Outlook: send both plaintext and PGP by default, discover keys, and decrypt in place.",
  "icons": {
    "128": "icon.svg"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "NewPGP",
    "default_icon": "icon.svg"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content/gmail.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*",
        "https://outlook.live.com/*"
      ],
      "js": ["content/outlook.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": ["nativeMessaging", "storage"],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://outlook.office.com/*",
    "https://outlook.office365.com/*",
    "https://outlook.live.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["ui/styles.css", "ui/content.css"],
      "matches": [
        "https://mail.google.com/*",
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*",
        "https://outlook.live.com/*"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "newpgp@newpgp.local",
      "strict_min_version": "115.0"
    }
  }
}
